# Preserve exact release bytes so SHA256.json checks survive clone on Windows or Linux.
* -text whitespace=cr-at-eol
*.bin binary
*.bit binary
*.pgm binary
*.pdf binary
# Preserve raw diagnostic bytes, including spaces emitted by native Tcl errors.
stream_video_enhance/reports/rtl/runtime/evidence/**/*.log -whitespace

# Preserve generated LCD timing tables and native simulator evidence verbatim.
stream_video_edge/reports/lcd/implementation/*.rpt -whitespace
stream_video_edge/reports/lcd/evidence/**/*.log -whitespace

# Preserve native UART implementation evidence.
stream_video_edge/reports/implementation/*.rpt -whitespace

# Preserve the current test-project snapshot and native tool reports without reformatting.
stream_video_edge_20fps/** whitespace=cr-at-eol,-blank-at-eof
stream_video_edge_20fps/reports/evidence/** -whitespace
