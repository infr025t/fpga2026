# LCD runtime captures are local; reviewed release evidence is tracked separately.
/stream_video_edge/reports/lcd/runtime/

# Vivado process metadata is generated outside the source project.
/dfx_runtime.txt
/clockInfo.txt

# Vivado may emit the same metadata when launched from the source directory.
/stream_video_edge/dfx_runtime.txt
/stream_video_edge/clockInfo.txt

# Current20fps project: generated tools/cache/captures stay local; selected evidence is tracked.
/stream_video_edge_20fps/build/
/stream_video_edge_20fps/.Xil/
/stream_video_edge_20fps/clockInfo.txt
/stream_video_edge_20fps/dfx_runtime.txt
