set_property -dict {PACKAGE_PIN P1 IOSTANDARD LVCMOS33} [get_ports {led[14]}]
set_property -dict {PACKAGE_PIN L1 IOSTANDARD LVCMOS33} [get_ports {led[15]}]
create_clock -name sys_clk -period 10.000 [get_ports clk100]
set_property -dict {PACKAGE_PIN J3 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[0]}]
set_property -dict {PACKAGE_PIN L3 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[1]}]
set_property -dict {PACKAGE_PIN M2 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[2]}]
set_property -dict {PACKAGE_PIN N2 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[3]}]
set_property -dict {PACKAGE_PIN K3 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[4]}]
set_property -dict {PACKAGE_PIN M3 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[5]}]
set_property -dict {PACKAGE_PIN M1 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[6]}]
set_property -dict {PACKAGE_PIN N1 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_data[7]}]
set_property -dict {PACKAGE_PIN A16 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_cs_n}]
set_property -dict {PACKAGE_PIN B15 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_rs}]
set_property -dict {PACKAGE_PIN B16 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_wr_n}]
set_property -dict {PACKAGE_PIN A15 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_rd_n}]
set_property -dict {PACKAGE_PIN A17 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_reset_n}]
set_property -dict {PACKAGE_PIN C15 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_bl}]
set_property -dict {PACKAGE_PIN M19 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_rclk}]
set_property -dict {PACKAGE_PIN L17 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_rrst_n}]
set_property -dict {PACKAGE_PIN A14 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_wrst_n}]
set_property -dict {PACKAGE_PIN P18 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_wen}]
set_property -dict {PACKAGE_PIN P17 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_rst_n}]
set_property -dict {PACKAGE_PIN K17 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_sioc}]
set_property -dict {PACKAGE_PIN M18 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {cam_siod}]
set_false_path -from [get_ports {btnC sw[*]}]
set_max_delay 10.000 -datapath_only -from [get_clocks sys_clk] -to [get_ports {lcd_data[*] lcd_cs_n lcd_rs lcd_wr_n lcd_rd_n lcd_reset_n lcd_bl}]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CFGBVS VCCO [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

set_property -dict {PACKAGE_PIN J1 IOSTANDARD LVCMOS33} [get_ports {cam_data[0]}]
set_property -dict {PACKAGE_PIN L2 IOSTANDARD LVCMOS33} [get_ports {cam_data[1]}]
set_property -dict {PACKAGE_PIN J2 IOSTANDARD LVCMOS33} [get_ports {cam_data[2]}]
set_property -dict {PACKAGE_PIN G2 IOSTANDARD LVCMOS33} [get_ports {cam_data[3]}]
set_property -dict {PACKAGE_PIN H1 IOSTANDARD LVCMOS33} [get_ports {cam_data[4]}]
set_property -dict {PACKAGE_PIN K2 IOSTANDARD LVCMOS33} [get_ports {cam_data[5]}]
set_property -dict {PACKAGE_PIN H2 IOSTANDARD LVCMOS33} [get_ports {cam_data[6]}]
set_property -dict {PACKAGE_PIN G3 IOSTANDARD LVCMOS33} [get_ports {cam_data[7]}]
set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33} [get_ports cam_vsync]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33 PULLDOWN TRUE} [get_ports cam_href]
set_false_path -from [get_ports {cam_vsync cam_href cam_sioc cam_siod}]
set_property IOB TRUE [get_ports cam_rclk]
set_property SLEW FAST [get_ports cam_rclk]
set_max_delay 5.000 -datapath_only -from [get_pins -hier -filter {NAME =~ camera/rclk_reg/Q}] -to [get_ports cam_rclk]
set_max_delay 32.000 -datapath_only -from [get_ports {cam_data[*]}]
set_min_delay 0.000 -from [get_ports {cam_data[*]}]
create_clock -name fifo_virtual -period 500.000
set_input_delay -clock fifo_virtual -max 25.000 [get_ports {cam_data[*]}]
set_input_delay -clock fifo_virtual -min 0.000 [get_ports {cam_data[*]}]
set_max_delay 20.000 -datapath_only -from [get_clocks sys_clk] -to [get_ports {cam_wen cam_rrst_n cam_wrst_n cam_rst_n cam_sioc cam_siod}]

# Human-visible LEDs have no synchronous external receiver.
# Use the same 20ns LED output budget as the formal camera project; keep all camera/LCD budgets.
set_max_delay 20.000 -datapath_only -from [get_clocks sys_clk] -to [get_ports {led[*]}]
